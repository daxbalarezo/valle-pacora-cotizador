# Firebase Configuración (Opcional - La app funciona al 100% de inmediato con persistencia local si no se configuran)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Drive (backend / Vercel). Pega aquí el JSON completo de una cuenta de
# servicio con acceso de lector a la carpeta de Drive. No uses esta variable con
# prefijo VITE_, porque sería expuesta en el navegador.
GOOGLE_SERVICE_ACCOUNT_JSON=
